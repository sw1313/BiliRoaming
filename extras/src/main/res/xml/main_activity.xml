<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/setting">
        <Preference
            android:key="setting"
            android:summary="@string/setting_summary"
            android:title="@string/setting_title" />

        <SwitchPreference
            android:key="hide_icon"
            android:summary="@string/hide_icon_summary"
            android:title="@string/hide_icon_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about">
        <Preference
            android:key="version"
            android:title="@string/version" />
        <Preference android:key="running_status" />
    </PreferenceCategory>
</PreferenceScreen>
