    <string name="block_up_share_goods_title">屏蔽 UP 主分享好物</string>
    <string name="block_up_share_goods_summary">屏蔽普通视频半屏详情页标签下方的「UP 主分享好物」模块</string>
    <string name="block_story_live_title">屏蔽竖屏模式直播</string>
    <string name="block_story_live_summary">屏蔽 Story 竖屏流中的直播卡片</string>
    <string name="block_story_ad_title">屏蔽竖屏模式广告视频</string>
    <string name="block_story_ad_summary">屏蔽 Story 竖屏流中的广告视频卡片（含「应用 / 点击直达」等效果广告，整条不再刷出）。注意：部分广告视频只是广告商买了推荐位的正常内容，整条屏蔽可能误伤，推荐不开</string>
    <string name="story_diversion_settings_title">屏蔽竖屏导流入口选项</string>
    <string name="story_diversion_settings_summary">分项屏蔽竖屏流的导流入口与浮层：左下角标签、番剧上方大会员条、直播预约、非 WiFi 流量卡推广、购物车与广告浮层等，按需勾选</string>
    <string name="story_background_auto_next_title">竖屏后台自动连播</string>
    <string name="story_background_auto_next_summary">竖屏视频后台或息屏播放结束后，自动切到下一个视频</string>
    <string name="foreground_auto_next_title">前台播放自动播放相关视频</string>
    <string name="foreground_auto_next_summary">播完后按下方「适用范围」自动播放 AI 推荐相关视频（超时走前台相关视频接口兜底）</string>
    <string name="foreground_auto_next_scopes_title">前台自动连播适用范围</string>
    <string name="foreground_auto_next_scopes_summary">勾选的视频类型播完后走 AI 联播流程</string>
    <string name="foreground_auto_next_orientation_title">前台连播视频方向偏好</string>
    <string name="foreground_auto_next_orientation_summary">从 AI 联播列表或相关视频列表中优先挑选符合方向的视频</string>
    <string name="media_button_control_title">媒体按键控制上下视频</string>
    <string name="media_button_control_summary">蓝牙耳机/线控的上一曲、下一曲按键切换视频（下一个全场景支持，上一个仅在可行场景支持，部分场景需配合对应连播开关）</string>
    <string name="hide_vip_center_title">屏蔽我的界面会员中心</string>
    <string name="hide_vip_center_summary">移除我的页面大会员横幅及会员中心入口</string>
    <string name="block_charging_video_title">屏蔽充电视频</string>
    <string name="block_charging_video_summary">屏蔽首页推荐、竖屏视频流、相关视频及自动连播中的充电专属视频。竖屏流靠自带标记识别；其余列表的卡片不带充电标记，会自动记住你打开/播放过的充电视频（持久保存）后续屏蔽，如需首次出现即屏蔽请同时开启下方“联网精准识别”</string>
    <string name="block_charging_video_net_title">充电视频联网精准识别</string>
    <string name="block_charging_video_net_summary">需配合“屏蔽充电视频”一起开启。首页推荐、相关视频、自动连播里的卡片本身不带充电标记，开启后会对其中的视频逐个调用 B 站接口查询 is_upower_exclusive 来精准识别并屏蔽（首次加载会产生少量额外网络请求，结果会缓存，每个视频只查一次，后续秒过；关闭则仅按已看过/已播放过的记录屏蔽）。注意：会增加视频下方推荐视频的显示延迟，推荐不开</string>
    <string name="block_charging_video_log_title">充电视频屏蔽调试日志</string>
    <string name="block_charging_video_log_summary">在 logcat 打印各处卡片字段，用于定位未确认的充电标记（仅排查时开启）</string>
    <string name="block_promoted_video_title">屏蔽运营推广视频</string>
    <string name="block_promoted_video_summary">屏蔽相关视频/连播里购买的运营推广位（与正在播放内容无关、多个视频下重复出现的“热搜”推送）</string>
    <string name="disable_chapter_progress_title">默认关闭章节进度条</string>
    <string name="disable_chapter_progress_summary">进入视频时自动关闭官方章节进度条，避免每个视频重复关闭和误触</string>
    <string name="sponsorblock_enable_title">空降助手</string>
    <string name="sponsorblock_enable_summary">自动跳过社区标注的恰饭片段</string>
    <string name="sponsorblock_settings_title">空降助手设置</string>
    <string name="sponsorblock_settings_summary">服务状态、分类、Toast、统计和服务器地址</string>
    <string name="show_info_title">显示激活提示</string>
    <string name="show_info_summary">哔哩哔哩启动时显示漫游扩展激活 Toast</string>
    <string name="extras_verbose_log_title">详细日志（调试）</string>
    <string name="extras_verbose_log_summary">仅排查问题时开启：输出各功能的逐事件追踪日志。关闭时只保留激活确认与错误日志</string>
